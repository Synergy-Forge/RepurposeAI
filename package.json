{
  "name": "repurpose_ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx src/lib/workers/emailWorker.ts",
    "dev:video-worker": "tsx src/lib/workers/videoWorker.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\" \"npm run dev:video-worker\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:redis": "tsx scripts/test-redis.ts",
    "test:smoke": "tsx scripts/test-smoke.ts",
    "test:video-queue": "tsx scripts/test-video-queue.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
