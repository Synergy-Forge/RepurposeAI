{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,
    "allowJs": false
  },
  "include": [
    "src/lib/redis/**/*.ts",
    "src/lib/queues/**/*.ts",
    "src/lib/workers/**/*.ts"
  ]
}
